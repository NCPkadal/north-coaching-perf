# Formspree: create two forms at https://formspree.io (Discovery Call + Contact)
# and paste the form IDs here (the part after /f/ in the form URL).
# Then copy this file to .env.local and fill in the values.

NEXT_PUBLIC_FORMSPREE_BOOKING_ID=
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=

# Google Tag Manager: container ID from tagmanager.google.com (e.g. GTM-MMHPJZNV).
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4: Measurement ID (e.g. G-9E9PGE42Z6). Used for gtag.js.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
